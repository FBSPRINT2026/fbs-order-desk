# Copy these into Vercel > Project > Settings > Environment Variables
# (or into a .env.local file if you run the app on your own computer)

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The web address the app runs at, no trailing slash
NEXT_PUBLIC_SITE_URL=https://portal.fbsprint.com

# Stripe > Developers > API keys, and the webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email alerts through Brevo (brevo.com). Leave blank to turn email alerts off.
BREVO_API_KEY=
# (Resend also works instead of Brevo: set RESEND_API_KEY and leave BREVO_API_KEY blank)
RESEND_API_KEY=
EMAIL_FROM=FBS Print <orders@fbsprint.com>
SHOP_NOTIFY_EMAIL=nicholas@fbsprint.com
